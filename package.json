{
  "name": "miss-beta",
  "version": "26.4.0",
  "description": "MISS β: planetary defense sim. Vector-line, green-on-black, real orbital mechanics underneath.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "MISS_BENCH=1 vitest run",
    "probe": "MISS_BENCH=probe vitest run",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "safety": "bash scripts/safety.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spaced-lab/miss-beta.git"
  },
  "homepage": "https://spaced-lab.github.io/miss-beta/",
  "bugs": {
    "url": "https://github.com/spaced-lab/miss-beta/issues"
  }
}
